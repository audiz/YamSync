<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Разрешение для работы эквалайзера/спектроанализатора Visualizer на сессии аудиоплеера -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Добавляем классические разрешения для совместимости со старыми версиями Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <application
            android:allowBackup="true"
            android:label="YamSync"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:requestLegacyExternalStorage="true"
            android:usesCleartextTraffic="true">

        <activity
                android:name="io.github.audiz.android.MainActivity"
                android:exported="true"
                android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 🔗 Deep Link: yamsync://track/... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yamsync" />
            </intent-filter>

            <!-- 🔗 Универсальные ссылки: https://music.yandex.ru/track/... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="music.yandex.ru" android:pathPrefix="/track" />
                <data android:scheme="https" android:host="music.yandex.ru" android:pathPrefix="/album" />
            </intent-filter>
        </activity>

        <!-- 📤 FileProvider для отправки аудиофайлов в мессенджеры -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
        </provider>

        <service
                android:name="io.github.audiz.MediaPlaybackService"
                android:foregroundServiceType="mediaPlayback"
                android:exported="false" />

    </application>
</manifest>